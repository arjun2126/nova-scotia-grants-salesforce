<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Employee_Threshold</fullName>
    <active>true</active>
    <description>Illustrative rule. Applicant employee count must fall inside the program thresholds.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Account__r.Employee_Count__c)), OR(AND(NOT(ISBLANK(Program__r.Min_Employees__c)), Account__r.Employee_Count__c &lt; Program__r.Min_Employees__c), AND(NOT(ISBLANK(Program__r.Max_Employees__c)), Account__r.Employee_Count__c &gt; Program__r.Max_Employees__c)))</errorConditionFormula>
    <errorDisplayField>Account__c</errorDisplayField>
    <errorMessage>Applicant employee count is outside the illustrative program thresholds.</errorMessage>
</ValidationRule>
