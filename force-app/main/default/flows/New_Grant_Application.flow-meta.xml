<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>A_Set_Existing_Account</name>
        <label>Set Existing Account</label>
        <locationX>150</locationX>
        <locationY>550</locationY>
        <assignmentItems>
            <assignToReference>accountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Existing_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Program</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A_Set_New_Account</name>
        <label>Set New Account</label>
        <locationX>350</locationX>
        <locationY>550</locationY>
        <assignmentItems>
            <assignToReference>accountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_New_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Program</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Program_DAP</name>
        <choiceText>Digital Adoption Program</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>DAP-DEMO</stringValue>
        </value>
    </choices>
    <choices>
        <name>Program_EDP</name>
        <choiceText>Export Development Program</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>EDP-DEMO</stringValue>
        </value>
    </choices>
    <choices>
        <name>Program_PIVP</name>
        <choiceText>Productivity and Innovation Voucher Program</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>PIVP-DEMO</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Advanced_Manufacturing</name>
        <choiceText>Advanced Manufacturing</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Advanced Manufacturing</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Clean_Technology</name>
        <choiceText>Clean Technology</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Clean Technology</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Life_Sciences</name>
        <choiceText>Life Sciences</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Life Sciences</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Ocean_Technology</name>
        <choiceText>Ocean Technology</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Ocean Technology</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Other</name>
        <choiceText>Other</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <choices>
        <name>Sector_Technology</name>
        <choiceText>Technology</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Technology</stringValue>
        </value>
    </choices>
    <decisions>
        <name>D_Account_Exists</name>
        <label>Account Exists</label>
        <locationX>150</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Create_New_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New Account</defaultConnectorLabel>
        <rules>
            <name>Use_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_Set_Existing_Account</targetReference>
            </connector>
            <label>Use Existing</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_Program_Found</name>
        <label>Program Found</label>
        <locationX>150</locationX>
        <locationY>750</locationY>
        <defaultConnector>
            <targetReference>S_No_Program</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Program</defaultConnectorLabel>
        <rules>
            <name>Program_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Program</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Application</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Screen flow that intakes a new grant application. Collects business and program details, reuses an existing Account by Nova Scotia business number or creates one, validates the selected program is active, then creates a submitted Application. Fictional demonstration data only.</description>
    <interviewLabel>New Grant Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Grant Application</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Application</name>
        <label>Create Application</label>
        <locationX>150</locationX>
        <locationY>850</locationY>
        <connector>
            <targetReference>S_Done</targetReference>
        </connector>
        <faultConnector>
            <targetReference>S_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>accountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Eligibility_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Program__c</field>
            <value>
                <elementReference>Get_Program.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Region__c</field>
            <value>
                <elementReference>Region</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requested_Amount__c</field>
            <value>
                <elementReference>Requested_Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sector__c</field>
            <value>
                <elementReference>Sector</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_New_Account</name>
        <label>Create New Account</label>
        <locationX>350</locationX>
        <locationY>450</locationY>
        <connector>
            <targetReference>A_Set_New_Account</targetReference>
        </connector>
        <faultConnector>
            <targetReference>S_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>NS_Business_Number__c</field>
            <value>
                <elementReference>NS_Business_Number</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Business_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Region__c</field>
            <value>
                <elementReference>Region</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sector__c</field>
            <value>
                <elementReference>Sector</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Account</name>
        <label>Get Existing Account</label>
        <locationX>150</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_Account_Exists</targetReference>
        </connector>
        <faultConnector>
            <targetReference>S_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NS_Business_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NS_Business_Number</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Program</name>
        <label>Get Program</label>
        <locationX>150</locationX>
        <locationY>650</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_Program_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>S_Error</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Program_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Program_Code</elementReference>
            </value>
        </filters>
        <filters>
            <field>Program_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Program__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>S_Done</name>
        <label>Application Submitted</label>
        <locationX>150</locationX>
        <locationY>950</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Done_Text</name>
            <fieldText>Your application was submitted for {!Get_Program.Name}. Requested amount: CAD {!Requested_Amount}. Open Applications to review the submitted record. Submission does not guarantee eligibility or funding approval.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Error</name>
        <label>Submission Needs Attention</label>
        <locationX>550</locationX>
        <locationY>850</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>Something went wrong while creating the application. Details for an administrator: {!$Flow.FaultMessage}</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Intake</name>
        <label>Step 1: Business and Funding Request</label>
        <locationX>150</locationX>
        <locationY>250</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Existing_Account</targetReference>
        </connector>
        <fields>
            <name>Intake_Help</name>
            <fieldText>Enter fictional business details and choose a funding program. A matching business number reuses the existing Account. Select Next to submit your request for eligibility review; this does not approve funding.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Business_Name</name>
            <dataType>String</dataType>
            <fieldText>Business Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>NS_Business_Number</name>
            <dataType>String</dataType>
            <fieldText>Nova Scotia Business Number</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Sector</name>
            <choiceReferences>Sector_Technology</choiceReferences>
            <choiceReferences>Sector_Ocean_Technology</choiceReferences>
            <choiceReferences>Sector_Clean_Technology</choiceReferences>
            <choiceReferences>Sector_Life_Sciences</choiceReferences>
            <choiceReferences>Sector_Advanced_Manufacturing</choiceReferences>
            <choiceReferences>Sector_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Sector</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Region</name>
            <dataType>String</dataType>
            <fieldText>Region</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Program_Code</name>
            <choiceReferences>Program_DAP</choiceReferences>
            <choiceReferences>Program_EDP</choiceReferences>
            <choiceReferences>Program_PIVP</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Program</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Requested_Amount</name>
            <dataType>Number</dataType>
            <fieldText>Requested Amount (CAD)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_No_Program</name>
        <label>Program Not Available</label>
        <locationX>350</locationX>
        <locationY>750</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>No_Program_Text</name>
            <fieldText>No active program matches your selection. No application was submitted. Ask the program administrator to review availability before trying again. A business Account may already have been created earlier in this intake.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>S_Intake</startElementReference>
    <status>Active</status>
    <variables>
        <name>accountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
